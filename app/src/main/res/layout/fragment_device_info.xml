<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ====== Legitimacy Score Card ====== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_legitimacy"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <!-- Score Display -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_legitimacy_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="48sp"
                            android:textStyle="bold"
                            tools:text="95" />

                        <TextView
                            android:id="@+id/tv_legitimacy_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            tools:text="正常" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_legitimacy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:max="100"
                            android:progress="95"
                            app:indicatorColor="?attr/colorOnPrimaryContainer"
                            app:trackColor="@color/md_theme_light_primary"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />
                    </LinearLayout>

                    <!-- Check Items - Chip Group -->
                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="4dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tv_check_build"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:textSize="11sp"
                            app:chipBackgroundColor="@android:color/transparent"
                            app:chipCornerRadius="8dp"
                            app:chipMinHeight="28dp"
                            app:chipStrokeColor="?attr/colorOnPrimaryContainer"
                            app:chipStrokeWidth="1dp"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            tools:text="Build一致性 ✓" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tv_check_rom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:textSize="11sp"
                            app:chipBackgroundColor="@android:color/transparent"
                            app:chipCornerRadius="8dp"
                            app:chipMinHeight="28dp"
                            app:chipStrokeColor="?attr/colorOnPrimaryContainer"
                            app:chipStrokeWidth="1dp"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            tools:text="ROM匹配 ✓" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tv_check_service"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:textSize="11sp"
                            app:chipBackgroundColor="@android:color/transparent"
                            app:chipCornerRadius="8dp"
                            app:chipMinHeight="28dp"
                            app:chipStrokeColor="?attr/colorOnPrimaryContainer"
                            app:chipStrokeWidth="1dp"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            tools:text="服务匹配 ✓" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tv_check_hardware"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:textSize="11sp"
                            app:chipBackgroundColor="@android:color/transparent"
                            app:chipCornerRadius="8dp"
                            app:chipMinHeight="28dp"
                            app:chipStrokeColor="?attr/colorOnPrimaryContainer"
                            app:chipStrokeWidth="1dp"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            tools:text="硬件一致 ✓" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/tv_check_fingerprint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:textSize="11sp"
                            app:chipBackgroundColor="@android:color/transparent"
                            app:chipCornerRadius="8dp"
                            app:chipMinHeight="28dp"
                            app:chipStrokeColor="?attr/colorOnPrimaryContainer"
                            app:chipStrokeWidth="1dp"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            tools:text="指纹格式 ✓" />

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ====== Basic Info Card ====== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_phone"
                        android:drawablePadding="8dp"
                        android:text="@string/basic_info"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        app:drawableTint="?attr/colorPrimary" />

                    <include android:id="@+id/row_brand" layout="@layout/item_info_row" />
                    <include android:id="@+id/row_model" layout="@layout/item_info_row" />
                    <include android:id="@+id/row_manufacturer" layout="@layout/item_info_row" />
                    <include android:id="@+id/row_device" layout="@layout/item_info_row" />
                    <include android:id="@+id/row_board" layout="@layout/item_info_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ====== System Info Card ====== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_info"
                        android:drawablePadding="8dp"
                        android:text="@string/system_info"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        app:drawableTint="?attr/colorPrimary" />

                    <include android:id="@+id/row_android_version" layout="@layout/item_info_row" />
                    <include android:id="@+id/row_api_level" layout="@layout/item_info_row" />
                    <include android:id="@+id/row_rom_version" layout="@layout/item_info_row" />
                    <include android:id="@+id/row_security_patch" layout="@layout/item_info_row" />
                    <include android:id="@+id/row_kernel_version" layout="@layout/item_info_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ====== Hardware Info Card ====== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_debug"
                        android:drawablePadding="8dp"
                        android:text="@string/hardware_info"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        app:drawableTint="?attr/colorPrimary" />

                    <include android:id="@+id/row_cpu" layout="@layout/item_info_row" />
                    <include android:id="@+id/row_memory" layout="@layout/item_info_row" />
                    <include android:id="@+id/row_storage" layout="@layout/item_info_row" />
                    <include android:id="@+id/row_screen" layout="@layout/item_info_row" />
                    <include android:id="@+id/row_sensors" layout="@layout/item_info_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ====== Vendor Services Card ====== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_integrity"
                        android:drawablePadding="8dp"
                        android:text="@string/vendor_services"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        app:drawableTint="?attr/colorPrimary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_vendor_services"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ====== ROM Features Card ====== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_shield"
                        android:drawablePadding="8dp"
                        android:text="@string/rom_features"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        app:drawableTint="?attr/colorPrimary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_rom_features"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
