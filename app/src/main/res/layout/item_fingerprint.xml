<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginTop="8dp">

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="ANDROID_ID" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="9a8b7c6d5e4f3a2b" />

        <ImageButton
            android:id="@+id/btn_copy"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/copy"
            android:src="@drawable/ic_copy"
            app:tint="@color/text_hint" />
    </LinearLayout>

    <!-- Layer Values -->
    <LinearLayout
        android:id="@+id/layout_layers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_java_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            tools:text="Java: 9a8b..." />

        <TextView
            android:id="@+id/tv_native_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            tools:text="Native: 9a8b..." />

        <ImageView
            android:id="@+id/iv_consistency"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_status_safe" />

        <TextView
            android:id="@+id/tv_consistency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/status_safe"
            android:textSize="10sp"
            tools:text="一致" />

    </LinearLayout>

</LinearLayout>
